"""
Real-time plotter for the capacitive taxel readout (CapSensor firmware).

Understands the lines the Arduino sends:
    raw:<step> delta:<step - baseline>     normal mode
    hi:<avg high> lo:<avg low>             debug mode (0-1023 ADC levels)
    # baseline: <value>                    after each calibration

Keys (click the plot window first):
    c  -> recalibrate baseline on the Arduino (keep the sensor untouched)
    d  -> toggle debug mode on the Arduino
    r  -> show/hide the raw line in normal mode
"""

import re
import time

import matplotlib

try:
    matplotlib.use("Qt5Agg")
except ImportError:
    pass

import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation
import serial
import serial.tools.list_ports

BAUD_RATE = 9600      # must match Serial.begin() in main.cpp
MAX_POINTS = 300

# Free up keys that matplotlib uses for its own shortcuts
for key in ("c", "d", "r"):
    for name, keys in plt.rcParams.items():
        if name.startswith("keymap.") and key in keys:
            plt.rcParams[name] = [k for k in keys if k != key]


# --- Automatic port selection ---
def get_arduino_port():
    ports = list(serial.tools.list_ports.comports())
    if not ports:
        return None
    for p in ports:
        if any(k in p.description for k in ["Arduino", "CH340", "USB", "Serial"]):
            print(f"Auto-selected: {p.device} ({p.description})")
            return p.device
    print(f"Defaulting to first available port: {ports[0].device}")
    return ports[0].device


SERIAL_PORT = get_arduino_port()
if not SERIAL_PORT:
    print("\n[ERROR] No active COM ports found.")
    print("1. Check if your Arduino USB cable is plugged in.")
    print("2. Make sure you installed the Arduino driver (e.g., CH340 / FT232R).")
    print("3. Check Device Manager under 'Ports (COM & LPT)'.")
    raise SystemExit(1)

try:
    ser = serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=0.1)
    time.sleep(2)  # the Uno resets when the port opens
    ser.reset_input_buffer()
    print(f"Connected to {SERIAL_PORT} at {BAUD_RATE} baud\n")
except Exception as e:
    print(f"Error opening port {SERIAL_PORT}: {e}")
    raise SystemExit(1)


# --- Line parsing ---
NUM = r"(-?\d+(?:\.\d+)?)"
RE_NORMAL = re.compile(rf"raw:\s*{NUM}\s+delta:\s*{NUM}")
RE_DEBUG = re.compile(rf"hi:\s*{NUM}\s+lo:\s*{NUM}")
RE_BASE = re.compile(rf"#\s*baseline:\s*{NUM}")

# --- State ---
mode = None            # "normal" or "debug", set by the first parsed line
baseline = None
show_raw = False
count = 0
x_data, a_data, b_data = [], [], []   # normal: delta/raw   debug: hi/lo


def reset_buffers():
    x_data.clear()
    a_data.clear()
    b_data.clear()


# --- Plot setup ---
fig, ax = plt.subplots(figsize=(9, 4.5))
line_a, = ax.plot([], [], color="limegreen", linewidth=1.5)
line_b, = ax.plot([], [], color="dodgerblue", linewidth=1.2)
zero_line = ax.axhline(0, color="gray", linewidth=0.8, linestyle=":")
ax.set_xlabel("Sample")
ax.grid(True, linestyle="--", alpha=0.5)
status = ax.text(0.99, 0.02, "", transform=ax.transAxes,
                 ha="right", va="bottom", fontsize=9, color="gray")


def apply_mode_style():
    if mode == "debug":
        ax.set_title("Debug: node B levels after each edge (0–1023)")
        ax.set_ylabel("ADC counts")
        line_a.set_label("hi (after rising edge)")
        line_b.set_label("lo (after falling edge)")
        line_b.set_visible(True)
        zero_line.set_visible(False)
    else:
        ax.set_title("Capacitive taxel: change from baseline (press → negative)")
        ax.set_ylabel("ADC counts")
        line_a.set_label("delta")
        line_b.set_label("raw")
        line_b.set_visible(show_raw)
        zero_line.set_visible(True)
    ax.legend(loc="upper left")


def handle_line(line):
    global mode, baseline, count

    m = RE_BASE.search(line)
    if m:
        baseline = float(m.group(1))
        print(f"Baseline: {baseline:.2f}")
        return

    m = RE_DEBUG.search(line)
    new_mode = "debug" if m else None
    if not m:
        m = RE_NORMAL.search(line)
        new_mode = "normal" if m else None
    if not m:
        return

    if new_mode != mode:
        mode = new_mode
        reset_buffers()
        apply_mode_style()

    v1, v2 = float(m.group(1)), float(m.group(2))
    count += 1
    x_data.append(count)
    if mode == "debug":
        a_data.append(v1)   # hi
        b_data.append(v2)   # lo
    else:
        a_data.append(v2)   # delta
        b_data.append(v1)   # raw

    if len(x_data) > MAX_POINTS:
        x_data.pop(0)
        a_data.pop(0)
        b_data.pop(0)


def update(_frame):
    while ser.in_waiting:
        line = ser.readline().decode("utf-8", errors="ignore").strip()
        if line:
            handle_line(line)

    if not x_data:
        return line_a, line_b

    line_a.set_data(x_data, a_data)
    line_b.set_data(x_data, b_data)
    ax.set_xlim(x_data[0], x_data[-1] + 1)

    if mode == "debug":
        vals = a_data + b_data
        lo_lim, hi_lim = min(vals), max(vals)
        margin = max(10, (hi_lim - lo_lim) * 0.1)
        ax.set_ylim(max(-5, lo_lim - margin), min(1028, hi_lim + margin))
        step = a_data[-1] - b_data[-1]
        status.set_text(f"hi {a_data[-1]:.1f}   lo {b_data[-1]:.1f}   step {step:.1f}")
    else:
        vals = a_data + (b_data if show_raw else []) + [0]
        lo_lim, hi_lim = min(vals), max(vals)
        margin = max(1, (hi_lim - lo_lim) * 0.1)
        ax.set_ylim(lo_lim - margin, hi_lim + margin)
        base_txt = f"baseline {baseline:.2f}   " if baseline is not None else ""
        status.set_text(f"{base_txt}raw {b_data[-1]:.2f}   delta {a_data[-1]:.2f}")

    return line_a, line_b


def on_key(event):
    global show_raw
    if event.key == "c":
        ser.write(b"c")
        reset_buffers()
        print("Recalibrating (keep the sensor untouched)...")
    elif event.key == "d":
        ser.write(b"d")
        print("Toggling debug mode...")
    elif event.key == "r" and mode == "normal":
        show_raw = not show_raw
        apply_mode_style()


fig.canvas.mpl_connect("key_press_event", on_key)
ani = FuncAnimation(fig, update, interval=30, blit=False, cache_frame_data=False)

plt.tight_layout()
try:
    plt.show()
finally:
    ser.close()